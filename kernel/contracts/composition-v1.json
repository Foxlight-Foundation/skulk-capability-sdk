        "descriptor_revision": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:@-]+$",
          "type": "string"
