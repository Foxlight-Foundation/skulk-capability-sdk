        "version": {
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "capability_id",
        "version",
        "descriptor_revision",
        "processing_domain",
        "behavior"
