{
  "status": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "description": "Observation envelope of one operation; opaque references, safe errors.",
    "properties": {
      "operation_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9._:@-]+$",
        "title": "Operation Id",
        "type": "string"
      },
      "state": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled",
          "interrupted"
        ],
        "title": "State",
        "type": "string"
      },
      "submission": {
        "enum": [
          "pending",
          "uncertain",
          "accepted"
        ],
        "title": "Submission",
        "type": "string"
      },
      "progress": {
        "anyOf": [
          {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Progress"
      },
      "stage": {
        "anyOf": [
          {
            "maxLength": 64,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Stage"
      },
      "queue_position": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Queue Position"
      },
      "submitted_at": {
        "minimum": 0,
        "title": "Submitted At",
        "type": "integer"
      },
      "updated_at": {
        "minimum": 0,
        "title": "Updated At",
        "type": "integer"
      },
      "finished_at": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Finished At"
      },
      "stale": {
        "title": "Stale",
        "type": "boolean"
      },
      "input_digest": {
        "pattern": "^[a-f0-9]{64}$",
        "title": "Input Digest",
        "type": "string"
      },
      "backend_reference": {
        "anyOf": [
          {
            "maxLength": 1024,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Backend Reference"
      },
      "input": {
        "anyOf": [
          {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "The recorded start input, so a caller can run the operation again or vary it. Carried by ``status`` when it fits beside the result (``MAX_INPUT_ECHO_BYTES``); listings omit it.",
        "title": "Input"
      },
      "result": {
        "anyOf": [
          {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Result"
      },
      "error": {
        "anyOf": [
          {
            "maxLength": 256,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Error"
      }
    },
    "required": [
      "operation_id",
      "state",
      "submission",
      "submitted_at",
      "updated_at",
      "stale",
      "input_digest"
    ],
    "title": "OperationStatus",
    "type": "object"
  },
  "page": {
    "$defs": {
      "JsonValue": {},
      "OperationStatus": {
        "additionalProperties": false,
        "description": "Observation envelope of one operation; opaque references, safe errors.",
        "properties": {
          "operation_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9._:@-]+$",
            "title": "Operation Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "interrupted"
            ],
            "title": "State",
            "type": "string"
          },
          "submission": {
            "enum": [
              "pending",
              "uncertain",
              "accepted"
            ],
            "title": "Submission",
            "type": "string"
          },
          "progress": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Progress"
          },
          "stage": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stage"
          },
          "queue_position": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Queue Position"
          },
          "submitted_at": {
            "minimum": 0,
            "title": "Submitted At",
            "type": "integer"
          },
          "updated_at": {
            "minimum": 0,
            "title": "Updated At",
            "type": "integer"
          },
          "finished_at": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Finished At"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          },
          "input_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Input Digest",
            "type": "string"
          },
          "backend_reference": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Backend Reference"
          },
          "input": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The recorded start input, so a caller can run the operation again or vary it. Carried by ``status`` when it fits beside the result (``MAX_INPUT_ECHO_BYTES``); listings omit it.",
            "title": "Input"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error"
          }
        },
        "required": [
          "operation_id",
          "state",
          "submission",
          "submitted_at",
          "updated_at",
          "stale",
          "input_digest"
        ],
        "title": "OperationStatus",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "One page of retained operations, newest first, compacted.\n\nResults and backend references can each reach their bounds, so a listing\ncarries statuses without them (``status`` returns the full record) and at\nmost ``PAGE_SIZE`` entries; ``next_offset`` continues the listing.",
    "properties": {
      "operations": {
        "items": {
          "$ref": "#/$defs/OperationStatus"
        },
        "maxItems": 16,
        "title": "Operations",
        "type": "array"
      },
      "next_offset": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Next Offset"
      },
      "active": {
        "minimum": 0,
        "title": "Active",
        "type": "integer"
      },
      "outstanding": {
        "default": 0,
        "description": "Interrupted rows: the backend may still hold their jobs.",
        "minimum": 0,
        "title": "Outstanding",
        "type": "integer"
      }
    },
    "required": [
      "operations",
      "active"
    ],
    "title": "OperationPage",
    "type": "object"
  },
  "log": {
    "additionalProperties": false,
    "description": "One offset-addressed slice of an operation's bounded log.",
    "properties": {
      "operation_id": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9._:@-]+$",
        "title": "Operation Id",
        "type": "string"
      },
      "offset": {
        "minimum": 0,
        "title": "Offset",
        "type": "integer"
      },
      "next_offset": {
        "minimum": 0,
        "title": "Next Offset",
        "type": "integer"
      },
      "truncated": {
        "title": "Truncated",
        "type": "boolean"
      },
      "text": {
        "maxLength": 8192,
        "title": "Text",
        "type": "string"
      }
    },
    "required": [
      "operation_id",
      "offset",
      "next_offset",
      "truncated",
      "text"
    ],
    "title": "OperationLog",
    "type": "object"
  },
  "plan": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "description": "Immutable estimate a caller reviews before ``start``.",
    "properties": {
      "plan_digest": {
        "pattern": "^[a-f0-9]{64}$",
        "title": "Plan Digest",
        "type": "string"
      },
      "summary": {
        "maxLength": 512,
        "minLength": 1,
        "title": "Summary",
        "type": "string"
      },
      "estimated_seconds": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Estimated Seconds"
      },
      "estimated_cost_microunits": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Estimated Cost Microunits"
      },
      "expires_at": {
        "minimum": 0,
        "title": "Expires At",
        "type": "integer"
      },
      "input": {
        "anyOf": [
          {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "The input to start with: the caller's, completed with what the plan chose (a seed, for one) and carrying ``plan_digest``, so the reviewed plan is the one that starts. Absent when the operation chooses nothing beyond the caller's input.",
        "title": "Input"
      }
    },
    "required": [
      "plan_digest",
      "summary",
      "expires_at"
    ],
    "title": "OperationPlan",
    "type": "object"
  }
}
