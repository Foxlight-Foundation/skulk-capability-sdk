{
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Immutable estimate a caller reviews before ``start``.",
  "properties": {
    "estimated_cost_microunits": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Cost Microunits"
    },
    "estimated_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Seconds"
    },
    "expires_at": {
      "minimum": 0,
      "title": "Expires At",
      "type": "integer"
    },
    "input": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The input to start with: the caller's, completed with what the plan chose (a seed, for one) and carrying ``plan_digest``, so the reviewed plan is the one that starts. Absent when the operation chooses nothing beyond the caller's input.",
      "title": "Input"
    },
    "plan_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "summary": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "plan_digest",
    "summary",
    "expires_at"
  ],
  "title": "OperationPlan",
  "type": "object"
}
